From 1eb0bce70ec67b210b515c50a32dd9da7fd8ff84 Mon Sep 17 00:00:00 2001
From: Souitou-iop <Souitou-iop@users.noreply.github.com>
Date: Wed, 14 Oct 2026 21:46:56 +0800
Subject: [PATCH] #196: WindowServer swaps wait for the GPU in NVAccel;
 commitAndWaitUntilSubmitted returns once submitted (test hook behind
 NVMTL_WSW_TESTHOOK)

---
 plugin/NVMTLEventSync.m |  1 +
 plugin/NVMTLObjects.h   |  1 +
 plugin/NVMTLObjects.m   | 32 ++++++++++++++++++++++++++++++++
 plugin/nvmtl_vk.c       | 12 ++++++++++++
 plugin/nvmtl_vk.h       |  1 +
 5 files changed, 47 insertions(+)

diff --git a/plugin/NVMTLEventSync.m b/plugin/NVMTLEventSync.m
index 3eb0bfe..e7add99 100644
--- a/plugin/NVMTLEventSync.m
+++ b/plugin/NVMTLEventSync.m
@@ -249,6 +249,7 @@ - (void)nvmtlFinishExecution:(NSError *)error {
     if (!error && _gpuTimingSeen && !_gpuTimingInvalid)
         (void)nvmtl_vk_interval_seconds(&_gpuTiming, &deviceStart, &deviceEnd);
     nvmtl_surface_finish_writes(self);
+    { const uint32_t wsw = __atomic_exchange_n(&_wswSeq, 0, __ATOMIC_ACQ_REL); if (wsw) (void)nvmtl_vk_wsw_op(3, wsw); }
     [_completionCondition lock];
     _gpuStart = deviceStart; _gpuEnd = deviceEnd;
     _legacyKernelEnd = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1e9;
diff --git a/plugin/NVMTLObjects.h b/plugin/NVMTLObjects.h
index 0507c6e..fa6a564 100644
--- a/plugin/NVMTLObjects.h
+++ b/plugin/NVMTLObjects.h
@@ -135,6 +135,7 @@ extern id gNVMTLMainDevice;
   NSCondition *_completionCondition;
   dispatch_group_t _callbackGroup, _scheduledGroup;
   BOOL _wasScheduled, _executionDone, _completionReady;
+  uint32_t _wswSeq;   // #196: WindowServer frame-fence number to report done at completion (0 = none)
   NSMutableArray *_signals;
   NSMutableArray *_waits;
 }
diff --git a/plugin/NVMTLObjects.m b/plugin/NVMTLObjects.m
index 948b135..6a1175a 100644
--- a/plugin/NVMTLObjects.m
+++ b/plugin/NVMTLObjects.m
@@ -5224,9 +5224,41 @@ - (void)encodeWaitForEvent:(id<MTLEvent>)e value:(uint64_t)v { [self nvmtlRecord
 // cannot order that swap after an NVK fence, so wait for the pixels to finish
 // before allowing the surface to become scanout. Other applications keep the
 // normal submission-only contract.
+// #196: with an NVAccel that knows the frame fence, the swap waits for the GPU in the kernel instead: the buffer is
+// tagged pending before it commits, reported done by the completion worker (nvmtlFinishExecution), and this call
+// returns once the buffer is submitted, so WindowServer's next frame overlaps this one's GPU work.
+// NVMTL_WS_GPUWAIT=0 keeps the CPU wait.
+static BOOL nvmtl_wsw_on(void) {
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("NVMTL_WS_GPUWAIT");
+        const uint32_t ack = (e && e[0] == '0') ? 0 : nvmtl_vk_wsw_op(1, 0);
+        on = ack == 0x4e565731u;
+        nvlog("WindowServer swaps: %s (NVMTL_WS_GPUWAIT=%s, NVAccel probe %#x)",
+              on ? "the kernel waits for each frame's GPU work; commitAndWaitUntilSubmitted returns once submitted"
+                 : "commitAndWaitUntilSubmitted waits for completion on the CPU", e ? e : "unset", ack);
+    }
+    return on;
+}
+- (void)nvmtlWaitSubmitted {
+    _nWait++; [_completionCondition lock];
+    while (!_wasScheduled && !_executionDone) [_completionCondition wait];
+    [_completionCondition unlock];
+}
 - (BOOL)commitAndWaitUntilSubmitted {
     static int ws = -1;
     if (ws < 0) ws = (getprogname() && !strcmp(getprogname(), "WindowServer")) ? 1 : 0;
+    if (ws && !_committed && nvmtl_wsw_on()) {
+        static _Atomic uint32_t wswNext;
+        uint32_t seq = atomic_fetch_add(&wswNext, 1) + 1;
+        if (!seq) seq = atomic_fetch_add(&wswNext, 1) + 1;
+        if (nvmtl_vk_wsw_op(2, seq) == 0) {
+            __atomic_store_n(&_wswSeq, seq, __ATOMIC_RELEASE);
+            [self commit];
+            [self nvmtlWaitSubmitted];
+            return self.status != MTLCommandBufferStatusError;
+        }
+    }
     [self commit];
     if (ws) [self waitUntilCompleted]; else [self waitUntilScheduled];
     return self.status != MTLCommandBufferStatusError;
diff --git a/plugin/nvmtl_vk.c b/plugin/nvmtl_vk.c
index a7af191..dc72a74 100644
--- a/plugin/nvmtl_vk.c
+++ b/plugin/nvmtl_vk.c
@@ -1968,6 +1968,18 @@ int nvmtl_vk_surface_dirty(uint32_t surfaceID, uint32_t plane)
     if (st) { static unsigned n; if (n++ < 8 || n % 2000 == 0) nvlog("surface %u dirty refused (%#x) - copy-out (%u so far)", surfaceID, st, n); }
     return st ? -1 : 0;
 }
+// #196: WindowServer frame fence. NVAccel takes these on NVRM's SURF_DIRTY escape when the plane field carries
+// 0x5753xxxx (op in the low half, sequence number in the surface id); see commitAndWaitUntilSubmitted.
+uint32_t nvmtl_vk_wsw_op(uint32_t op, uint32_t seq)
+{
+#ifdef NVMTL_WSW_TESTHOOK
+    { static uint32_t (*hook)(uint32_t, uint32_t); static int looked;
+      if (!looked) { hook = (uint32_t (*)(uint32_t, uint32_t))dlsym(RTLD_DEFAULT, "nvmtl_wsw_testhook"); looked = 1; }
+      if (hook) return hook(op, seq); }
+#endif
+    if (!pnvk_surface_dirty || !g_dev) return 0x80000002u;
+    return pnvk_surface_dirty(g_dev, seq, 0x57530000u | (op & 0xffffu));
+}
 int nvmtl_vk_surface_vram(uint32_t surfaceID, uint32_t plane, size_t need, nvk_buffer *out)
 {
     memset(out, 0, sizeof *out);
diff --git a/plugin/nvmtl_vk.h b/plugin/nvmtl_vk.h
index a2c6607..e39f8ef 100644
--- a/plugin/nvmtl_vk.h
+++ b/plugin/nvmtl_vk.h
@@ -348,3 +348,4 @@ int nvmtl_vk_cmd_image_gen_mipmaps(nvk_cmdbuf *c, nvk_image *img);
 int nvmtl_vk_surface_share_on(void);
 int nvmtl_vk_surface_vram(uint32_t surfaceID, uint32_t plane, size_t need, nvk_buffer *out);
 int nvmtl_vk_surface_dirty(uint32_t surfaceID, uint32_t plane);
+uint32_t nvmtl_vk_wsw_op(uint32_t op, uint32_t seq);
-- 
