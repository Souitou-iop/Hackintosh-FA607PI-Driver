From d8ff71c062a4b5d64eb248ae9eaa3cc7897bedf8 Mon Sep 17 00:00:00 2001
From: Souitou-iop <Souitou-iop@users.noreply.github.com>
Date: Wed, 14 Oct 2026 21:31:35 +0800
Subject: [PATCH] NVAccel #196: WindowServer frame fence - swaps wait for the
 GPU in the kernel

---
 accel/nvrm-accel.cpp | 133 ++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 125 insertions(+), 8 deletions(-)

diff --git a/accel/nvrm-accel.cpp b/accel/nvrm-accel.cpp
index 49347aa..aabc588 100644
--- a/accel/nvrm-accel.cpp
+++ b/accel/nvrm-accel.cpp
@@ -962,7 +962,9 @@ bool NVDisplayPipe::isTransactionComplete(IOAccelDisplayPipeTransaction2 *)
 
 static void nvAccelSurfScanoutSync(IOSurface *s);
 static bool nvAccelSurfCopyReady(IOSurface *s, unsigned head);
-static bool nvAccelIopFlip(IOService *fb, unsigned head, IOSurface *s, void *pipe);
+static bool nvAccelIopFlip(IOService *fb, unsigned head, IOSurface *s, void *pipe, unsigned wsw);
+static unsigned nvWswTarget(void);
+static void nvWswWait(unsigned target);
 static void nvAccelIopHome(IOService *fb, unsigned head);
 IOReturn NVDisplayPipe::performTransaction(IOAccelDisplayPipeTransaction2 *txn)
 {
@@ -976,6 +978,7 @@ IOReturn NVDisplayPipe::performTransaction(IOAccelDisplayPipeTransaction2 *txn)
     IOSurface *s  = txn->getPlaneIOSurface(0, 0);
     OSObject  *ro = txn->getPlaneResource(0, 0);
     if (!s && !ro) { OSAddAtomic64(1, &gCntIopEmpty); return kIOReturnSuccess; }
+    const unsigned wsw = nvWswTarget();
 
     const volatile unsigned int *src = nullptr; unsigned w = 0, h = 0, pitch = 0; bool fromRes = false;
     NVResource *res = OSDynamicCast(NVResource, ro);
@@ -993,6 +996,7 @@ IOReturn NVDisplayPipe::performTransaction(IOAccelDisplayPipeTransaction2 *txn)
              vm ? (unsigned long long)vm->fBytes : 0ull, (vm && vm->fKva) ? 1 : 0, vm ? (int)vm->fScanout : -1);
     }
     if (!s && vm && vm->fKva) {
+        nvWswWait(wsw);
         const unsigned char *rr = (const unsigned char *)res;
         w     = *(const volatile unsigned short *)(rr + 0xb0);
         h     = *(const volatile unsigned short *)(rr + 0xb2);
@@ -1000,7 +1004,7 @@ IOReturn NVDisplayPipe::performTransaction(IOAccelDisplayPipeTransaction2 *txn)
         if ((unsigned long long)pitch < 4ull * w) NVIOP_FAIL(kIOReturnBadArgument, "resource %ux%u: +0xb8 reads %u, which is not a row pitch (need >= %u) — not a surface buffer", w, h, pitch, 4u * w);
         if ((unsigned long long)h * pitch > vm->fBytes) NVIOP_FAIL(kIOReturnOverrun, "resource %ux%u pitch %u exceeds its %llu bytes", w, h, pitch, (unsigned long long)vm->fBytes);
         src = (const volatile unsigned int *)vm->fKva; fromRes = true;
-    } else if (s && nvAccelIopFlip(fb, head, s, this)) {
+    } else if (s && nvAccelIopFlip(fb, head, s, this, wsw)) {
         OSAddAtomic64(1, &gCntIopSrcSurf); OSAddAtomic64(1, &gCntIopOk); OSAddAtomic64(1, &gCntIopOkHead[head]);
         return kIOReturnSuccess;
     } else if (s) {
@@ -1008,6 +1012,7 @@ IOReturn NVDisplayPipe::performTransaction(IOAccelDisplayPipeTransaction2 *txn)
         // stale, one-colour buffer on the panel every other frame: full-screen flicker, 5 of 40 flicker recordings
         // (1.13-1.14.1), nvaccel_iop_blank about half of every copied frame, never on machines whose frames all flip.
         // Such a frame now keeps the previous picture on the panel instead.
+        nvWswWait(wsw);
         if (!nvAccelSurfCopyReady(s, head)) return kIOReturnSuccess;
         const unsigned fmt = s->getPixelFormat();
         if (fmt != 0x42475241u) NVIOP_FAIL(kIOReturnUnsupported, "surface 0x%x format 0x%08x is not BGRA", s->getSurfaceID(), fmt);
@@ -1150,6 +1155,108 @@ SYSCTL_INT(_debug, OID_AUTO, nvaccel_iop_async, CTLFLAG_RW | CTLFLAG_LOCKED, &gI
 NVACCEL_CNT(nvaccel_iop_async_flips,   gCntIopAsync,        "swaps completed asynchronously");
 NVACCEL_CNT(nvaccel_iop_async_refused, gCntIopAsyncRefused, "async swaps NVKMS refused (that frame stayed off the panel)");
 NVACCEL_CNT(nvaccel_iop_async_drop,    gCntIopAsyncDrop,    "frames dropped because a flip was still in flight (never expected)");
+// #196: WindowServer's frame fence. WindowServer swaps right after -commitAndWaitUntilSubmitted, and the swap has
+// to show finished pixels, so the plugin used to wait on the CPU for the whole frame to complete (~1.3 ms of a 6.9 ms
+// frame at 144 Hz, with no CPU/GPU overlap). Now the plugin tags each such command buffer with a sequence number
+// ("pending") before it commits and reports it "done" from its completion worker; the swap waits for every pending
+// number up to the newest one it saw before it reaches the panel -- on the async flip's thread call, so WindowServer
+// goes on to its next frame meanwhile. The ops ride NVRM's SURF_DIRTY escape with a magic in the plane field (NVRM
+// forwards the struct untouched); an older NVAccel rejects the probe (surface id 0) so the plugin keeps its CPU wait.
+#define NVRM_SS_KERNEL_ABI 1
+#include "../nvrm_surfshare_abi.h"
+#include <mach/mach_time.h>
+#define NVWSW_MAGIC 0x57530000u
+enum { NVWSW_PROBE = 1, NVWSW_PEND = 2, NVWSW_DONE = 3 };
+#define NVWSW_ACK   0x4e565731u
+static const unsigned kWswSlots = 32;
+static IOLock *gWswLock;
+static unsigned gWswSeq[kWswSlots];
+static uint64_t gWswT[kWswSlots];
+static volatile unsigned gWswLast;
+static int    gWsw = 1, gWswTimeoutMs = 100;
+static SInt64 gCntWswPend, gCntWswDone, gCntWswFull, gCntWswWaits, gCntWswWaitUs, gCntWswTimeout, gCntWswStale, gCntWswReject;
+SYSCTL_INT(_debug, OID_AUTO, nvaccel_wsw, CTLFLAG_RW | CTLFLAG_LOCKED, &gWsw, 0, "#196: 1 = WindowServer's swaps wait on the GPU in the kernel (plugin skips its CPU wait); 0 = refuse, the plugin waits on the CPU");
+SYSCTL_INT(_debug, OID_AUTO, nvaccel_wsw_timeout_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &gWswTimeoutMs, 0, "#196: longest a swap waits for its frame's GPU work before it flips anyway");
+NVACCEL_CNT(nvaccel_wsw_pend,    gCntWswPend,    "#196: WindowServer frames tagged pending");
+NVACCEL_CNT(nvaccel_wsw_done,    gCntWswDone,    "#196: WindowServer frames reported done");
+NVACCEL_CNT(nvaccel_wsw_full,    gCntWswFull,    "#196: pending tags refused (table full / disabled) -- that frame used the CPU wait");
+NVACCEL_CNT(nvaccel_wsw_waits,   gCntWswWaits,   "#196: swaps that had to sleep for the GPU");
+NVACCEL_CNT(nvaccel_wsw_wait_us, gCntWswWaitUs,  "#196: total microseconds swaps slept for the GPU");
+NVACCEL_CNT(nvaccel_wsw_timeout, gCntWswTimeout, "#196: swaps that gave up waiting (nvaccel_wsw_timeout_ms)");
+NVACCEL_CNT(nvaccel_wsw_stale,   gCntWswStale,   "#196: pending tags older than 1 s dropped");
+NVACCEL_CNT(nvaccel_wsw_reject,  gCntWswReject,  "#196: ops from a process that is not WindowServer");
+extern "C" void proc_selfname(char *buf, int size);
+static IOLock *nvWswLock(void)
+{
+    if (!gWswLock) { IOLock *l = IOLockAlloc(); if (l && !OSCompareAndSwapPtr(nullptr, l, (void *volatile *)&gWswLock)) IOLockFree(l); }
+    return gWswLock;
+}
+// Caller holds the lock. Drops tags older than a second (a WindowServer that died mid-frame).
+static bool nvWswOutstandingLocked(unsigned target)
+{
+    const uint64_t now = mach_absolute_time();
+    bool any = false;
+    for (unsigned i = 0; i < kWswSlots; i++) {
+        if (!gWswSeq[i]) continue;
+        if (now - gWswT[i] > 1000000000ull) { gWswSeq[i] = 0; OSAddAtomic64(1, &gCntWswStale); continue; }
+        if ((int)(gWswSeq[i] - target) <= 0) any = true;
+    }
+    return any;
+}
+static unsigned nvWswOp(unsigned op, unsigned seq)
+{
+    {
+        char nm[32]; nm[0] = 0; proc_selfname(nm, sizeof nm);
+        if (strncmp(nm, "WindowServer", sizeof nm)) { OSAddAtomic64(1, &gCntWswReject); return NVRM_SS_OFF; }
+    }
+    IOLock *lk = nvWswLock();
+    if (!lk) return NVRM_SS_OFF;
+    if (op == NVWSW_PROBE) return gWsw ? NVWSW_ACK : NVRM_SS_OFF;
+    if (!seq) return NVRM_SS_BAD_VERSION;
+    unsigned st = NVRM_SS_OFF;
+    IOLockLock(lk);
+    if (op == NVWSW_PEND) {
+        if (seq == 1) for (unsigned i = 0; i < kWswSlots; i++) gWswSeq[i] = 0;   // a new WindowServer
+        int k = -1;
+        if (gWsw) { (void)nvWswOutstandingLocked(seq); for (unsigned i = 0; i < kWswSlots; i++) if (!gWswSeq[i]) { k = (int)i; break; } }
+        if (k >= 0) { gWswSeq[k] = seq; gWswT[k] = mach_absolute_time(); gWswLast = seq; st = 0; OSAddAtomic64(1, &gCntWswPend); }
+        else OSAddAtomic64(1, &gCntWswFull);
+    } else if (op == NVWSW_DONE) {
+        for (unsigned i = 0; i < kWswSlots; i++) if (gWswSeq[i] == seq) { gWswSeq[i] = 0; st = 0; }
+        OSAddAtomic64(1, &gCntWswDone);
+        IOLockWakeup(lk, (event_t)gWswSeq, false);
+    }
+    IOLockUnlock(lk);
+    return st;
+}
+// The newest pending number when a swap arrives: its own frame's (the plugin tags before it commits).
+static unsigned nvWswTarget(void)
+{
+    if (!gWswLock) return 0;
+    IOLockLock(gWswLock);
+    const unsigned t = nvWswOutstandingLocked(gWswLast) ? gWswLast : 0;
+    IOLockUnlock(gWswLock);
+    return t;
+}
+static void nvWswWait(unsigned target)
+{
+    if (!target || !gWswLock) return;
+    const uint64_t t0 = mach_absolute_time();
+    bool slept = false;
+    IOLockLock(gWswLock);
+    while (nvWswOutstandingLocked(target)) {
+        uint64_t deadline; clock_interval_to_deadline((uint32_t)(gWswTimeoutMs > 0 ? gWswTimeoutMs : 1), kMillisecondScale, &deadline);
+        slept = true;
+        if (IOLockSleepDeadline(gWswLock, (event_t)gWswSeq, *(AbsoluteTime *)&deadline, THREAD_UNINT) == THREAD_TIMED_OUT
+            && nvWswOutstandingLocked(target)) {
+            for (unsigned i = 0; i < kWswSlots; i++) if (gWswSeq[i] && (int)(gWswSeq[i] - target) <= 0) gWswSeq[i] = 0;
+            OSAddAtomic64(1, &gCntWswTimeout);
+            break;
+        }
+    }
+    IOLockUnlock(gWswLock);
+    if (slept) { OSAddAtomic64(1, &gCntWswWaits); OSAddAtomic64((SInt64)((mach_absolute_time() - t0) / 1000), &gCntWswWaitUs); }
+}
 static int gCrcHead = 0;
 SYSCTL_INT(_debug, OID_AUTO, nvaccel_crc_head, CTLFLAG_RW | CTLFLAG_LOCKED, &gCrcHead, 0, "b85k-crc: which head debug.nvaccel_crc reads");
 static int nvaccel_crc_sysctl SYSCTL_HANDLER_ARGS;
@@ -1195,6 +1302,11 @@ static void nvaccelInstallSysctl(void)
     sysctl_register_oid(&sysctl__debug_nvaccel_iop_ok_h4);      sysctl_register_oid(&sysctl__debug_nvaccel_igpu);
     sysctl_register_oid(&sysctl__debug_nvaccel_heads_published); sysctl_register_oid(&sysctl__debug_nvaccel_heads_registered);
     sysctl_register_oid(&sysctl__debug_nvaccel_heads_piped);
+    sysctl_register_oid(&sysctl__debug_nvaccel_wsw);            sysctl_register_oid(&sysctl__debug_nvaccel_wsw_timeout_ms);
+    sysctl_register_oid(&sysctl__debug_nvaccel_wsw_pend);       sysctl_register_oid(&sysctl__debug_nvaccel_wsw_done);
+    sysctl_register_oid(&sysctl__debug_nvaccel_wsw_full);       sysctl_register_oid(&sysctl__debug_nvaccel_wsw_waits);
+    sysctl_register_oid(&sysctl__debug_nvaccel_wsw_wait_us);    sysctl_register_oid(&sysctl__debug_nvaccel_wsw_timeout);
+    sysctl_register_oid(&sysctl__debug_nvaccel_wsw_stale);      sysctl_register_oid(&sysctl__debug_nvaccel_wsw_reject);
     gSysctlInstalled = true;
     ALOG("sysctl debug.nvaccelfb installed -- `sudo sysctl -w debug.nvaccelfb=1` registers the framebuffer");
 #endif
@@ -1359,6 +1471,7 @@ static unsigned nvAccelSurfDirty(void *cache, NVResource *res, unsigned plane)
 }
 static IOReturn nvAccelSurfVram(struct NVRMSurfShareEsc *p, task_t task, unsigned cmd)
 {
+    if (cmd == NVRM_ESC_SURF_DIRTY && (p->plane & 0xffff0000u) == NVWSW_MAGIC) { p->status = nvWswOp(p->plane & 0xffffu, p->surfaceID); return kIOReturnSuccess; }
     p->hSrcClient = p->hSrcMemory = 0;
     if (p->version != NVRM_SURFSHARE_VERSION) { p->status = NVRM_SS_BAD_VERSION; return kIOReturnSuccess; }
     NVAccel *a = NVAccel::gAccel;
@@ -1582,7 +1695,7 @@ void _ZN18IOAccelDisplayPipe26signalTransactionInterruptEPv(void *pipe, void *ar
 struct thread_call *thread_call_allocate(void (*func)(void *, void *), void *param0);
 int thread_call_enter(struct thread_call *call);
 }
-struct NVIopAsync { void *pipe; IOService *fb; IOSurface *s; struct NVRMFlipRequest f; volatile SInt32 busy; struct thread_call *call; };
+struct NVIopAsync { void *pipe; IOService *fb; IOSurface *s; struct NVRMFlipRequest f; volatile SInt32 busy; struct thread_call *call; unsigned wsw; };
 static NVIopAsync gIopAs[kNvMaxFB];
 static SInt32 gIopAsyncRefuseRun;
 static bool nvAccelIopAsyncBusy(const void *pipe)
@@ -1596,6 +1709,7 @@ static void nvAccelIopAsyncRun(void *p0, void *)
     NVIopAsync *e = (NVIopAsync *)p0;
     const unsigned head = (unsigned)(e - gIopAs);
     IOSurface *s = e->s; e->s = nullptr;
+    nvWswWait(e->wsw); e->wsw = 0;
     const OSSymbol *sym = OSSymbol::withCStringNoCopy("nvFlipToSurfacePure");
     IOReturn rr = sym ? e->fb->callPlatformFunction(sym, false, &e->f, nullptr, nullptr, nullptr) : kIOReturnNoMemory;
     if (sym) sym->release();
@@ -1620,7 +1734,7 @@ static void nvAccelIopAsyncRun(void *p0, void *)
     __atomic_store_n(&e->busy, 0, __ATOMIC_RELEASE);
     _ZN18IOAccelDisplayPipe26signalTransactionInterruptEPv(e->pipe, nullptr);
 }
-static bool nvAccelIopAsyncStart(void *pipe, IOService *fb, unsigned head, IOSurface *s, const struct NVRMFlipRequest *f)
+static bool nvAccelIopAsyncStart(void *pipe, IOService *fb, unsigned head, IOSurface *s, const struct NVRMFlipRequest *f, unsigned wsw)
 {
     NVIopAsync *e = &gIopAs[head];
     for (unsigned i = 0; i < 50 && __atomic_load_n(&e->busy, __ATOMIC_ACQUIRE); i++) IOSleep(1);
@@ -1631,13 +1745,13 @@ static bool nvAccelIopAsyncStart(void *pipe, IOService *fb, unsigned head, IOSur
     if (!e->call) e->call = thread_call_allocate(nvAccelIopAsyncRun, e);
     if (!e->call) return false;
     ((OSObject *)s)->retain();
-    e->pipe = pipe; e->fb = fb; e->s = s;
+    e->pipe = pipe; e->fb = fb; e->s = s; e->wsw = wsw;
     for (unsigned i = 0; i < sizeof *f; i++) ((volatile unsigned char *)&e->f)[i] = ((const unsigned char *)f)[i];
     __atomic_store_n(&e->busy, 1, __ATOMIC_RELEASE);
     thread_call_enter(e->call);
     return true;
 }
-static bool nvAccelIopFlip(IOService *fb, unsigned head, IOSurface *s, void *pipe)
+static bool nvAccelIopFlip(IOService *fb, unsigned head, IOSurface *s, void *pipe, unsigned wsw)
 {
     if (!gIopFlip || !fb || !s || head >= kNvMaxFB) return false;
     // zero-copy scan-out is an NVIDIA display-engine flip; another vendor's panel (NMIntelFB) always takes the copy
@@ -1662,14 +1776,17 @@ static bool nvAccelIopFlip(IOService *fb, unsigned head, IOSurface *s, void *pip
         if (kmem) nvAccelIopCachePut(s, res, vm, kmem, bytes);
     }
     volatile unsigned short *valid = res ? *(unsigned short *volatile *)((volatile unsigned char *)res + 0x30) : nullptr;
-    const bool vramNewest = valid && (valid[6] & 1u);
+    bool vramNewest = valid && (valid[6] & 1u);
+    // a surface's first frame is only marked VRAM-newest once its GPU work completes
+    if (!vramNewest && wsw && valid) { nvWswWait(wsw); wsw = 0; vramNewest = (valid[6] & 1u) != 0; }
     if (!kmem) return nvAccelIopFlipNo(4);
     if (!vramNewest) return nvAccelIopFlipNo(5);
     const unsigned long long W = s->getWidth(), H = s->getHeight(), P = s->getBytesPerRow();
     if (!W || !H || P < 4 * W || H * P > bytes) return nvAccelIopFlipNo(6);
     struct NVRMFlipRequest f; nvSVZero(&f, sizeof f);
     f.version = NVRM_FLIP_ABI_VERSION; f.kapiMemory = kmem; f.allocationCookie = vm->fAllocationCookie; f.width = (unsigned)W; f.height = (unsigned)H; f.pitch = (unsigned)P;
-    if (gIopAsync && pipe) return nvAccelIopAsyncStart(pipe, fb, head, s, &f);
+    if (gIopAsync && pipe) return nvAccelIopAsyncStart(pipe, fb, head, s, &f, wsw);
+    nvWswWait(wsw);
     const OSSymbol *sym = OSSymbol::withCStringNoCopy("nvFlipToSurfacePure");
     IOReturn rr = sym ? fb->callPlatformFunction(sym, false, &f, nullptr, nullptr, nullptr) : kIOReturnNoMemory;
     if (sym) sym->release();
